# Fankaar Digital — Environment Variables
# Copy this to .env and fill in your values, or set in Railway dashboard

# ── LLM Configuration (REQUIRED for agents to work) ──────────────────
# Moonshot (Kimi) API — primary provider
MOONSHOT_API_KEY=sk-GetmlxGMmntzbmo6dfO5AzeqbIO6EHKIksnyI-WXz68ad3tv9
MOONSHOT_MODEL=kimi-latest

# Fallback providers (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── WhatsApp / Twilio (REQUIRED for daily reports) ───────────────────
# Twilio Account SID must start with AC (not US)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886
OWNER_WHATSAPP_NUMBER=+971501006735

# ── Agency Settings ──────────────────────────────────────────────────
AGENCY_NAME=Fankaar Digital
OWNER_NAME=Monis
APP_ENV=production

# ── Database ─────────────────────────────────────────────────────────
# In Docker/Railway: /app/data/fankaar.db
# Add a Railway Volume mounted at /app/data for persistence
DATABASE_PATH=/app/data/fankaar.db

# ── Stripe Billing (optional) ────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Server ───────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
