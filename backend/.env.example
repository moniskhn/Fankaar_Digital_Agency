# Claude Mythos / Fankaar Digital — environment template (copy to .env, fill in)
APP_ENV=production
LOG_LEVEL=warning
DATABASE_PATH=./app/data/mythos.db
CORS_ORIGINS=["*"]

# ── LLM provider ──
# options: kimi | moonshot | anthropic | openai | ollama | mock
LLM_PROVIDER=kimi

# Kimi Code (Anthropic-compatible) — get key at https://www.kimi.com/code/console
KIMI_API_KEY=sk-kimi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KIMI_BASE_URL=https://api.kimi.com/coding
KIMI_MODEL=kimi-for-coding

# Moonshot platform (OpenAI-compatible) — optional alternative
# MOONSHOT_API_KEY=sk-xxxx
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# MOONSHOT_MODEL=kimi-k2.6
